# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot).
# Админы могут публиковать новости (/post) и принимать/отклонять заявки.
ADMIN_IDS=

# Чат, куда приходят новые заявки (например, группа диспетчеров: -100…).
# Если пусто — заявки приходят каждому админу в личку.
ADMIN_CHAT_ID=

# Канал с новостями. Бот должен быть добавлен в канал администратором.
CHANNEL_ID=@your_channel
CHANNEL_URL=https://t.me/your_channel

# Тариф: подача машины + цена за км, но не меньше минимального заказа (грн)
BASE_PRICE=600
PRICE_PER_KM=25
MIN_PRICE=1000

# База данных SQLite
DB_PATH=gazel.db

# Карты (OpenStreetMap). Для Nominatim обязателен User-Agent с контактом.
GEOCODER_COUNTRIES=ua
# Адреса ищутся только в этом прямоугольнике (lon1,lat1,lon2,lat2) — сейчас Харьковская область.
# Оставьте пустым, чтобы искать по всей стране.
GEOCODER_VIEWBOX=34.8,50.5,38.2,48.5
# Язык названий улиц в ответах: uk — официальные украинские, ru — русские (где они есть в OSM)
GEOCODER_LANGUAGE=uk
USER_AGENT=GazelBot/0.1 (contact: you@example.com)
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org
# Если сервис маршрутов недоступен: расстояние по прямой × этот коэффициент
ROAD_FACTOR=1.3
